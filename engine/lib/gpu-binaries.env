# The single source for who holds the GPU on this machine: what a holder is called, which
# holders are the chat surface's own, and which are standing residents. Read by
# `engine/apps/gpu-lease/config.py` (behind the `gpu-lease` verb),
# `engine/infra/model-serving/hatch-serving-guard`, `hatch-image-front` beside it, and any
# status page that lists GPU holders.
# A name that is not here is invisible to every one of them: no refusal, no listing, no sweep.
#
# Sourceable by bash and parseable by Python: plain KEY="value", no expansion, no logic.
# Add a name here and every consumer sees it; there is nowhere else to add it.
# HATCH_CHAT_CONTAINERS keeps its old name: it is an override contract that tests and the
# harness set.

# SERVERS hold GPU memory for as long as they run. This is "who is holding the GPU right
# now", matched against a process's comm with `pgrep -x`, so the names must be exactly what
# shows in /proc/<pid>/comm. A GPU-holding binary the box runs and this line does not name
# is a violation nothing can see.
# `gufo` is the resident's engine; it runs in a podman container, and its comm is `gufo` on
# the host as well.
HATCH_GPU_SERVERS="llama-server|sd-server|gufo"

# TOOLS reach the GPU without serving: one-shot benchmarks and CLIs. They never appear as a
# holder to reason about, but a unit that runs one IS driving the GPU, which is the question
# hatch-serving-guard asks of a unit's ExecStart.
# `sd-cli` added 2026-09-21: the image comparison harness drives the GPU through it for
# minutes at a time, and it was in none of these lines, so a run of it was invisible to the
# lease, the guard and the taskboard together. `sd-server` was already in SERVERS.
HATCH_GPU_TOOLS="llama-bench|llama-cli|sd-cli"

# The router's GPU containers, space-separated, in podman's own naming. A container entry's
# server sits in the CONTAINER's cgroup, not llama-swap's, so the router unit alone cannot
# recognise it; this list is how the same tier is seen in its other shape. The lease, the
# guard and the taskboard read it: missing from the guard's view, the model reads as a foreign
# owner and every other load is refused (exit 97); missing from the lease's, sanctioned use is
# headlined as a NO LEASE violation. `hatch-qnext` is the resident on gufo (2026-09-28), the
# `--name` of its `podman run` in llama-swap.yaml.
HATCH_CHAT_CONTAINERS="hatch-qnext"

# THE STANDING TIER: the models only a human takes down. Declared in TWO keys, because a
# standing model can hold the GPU in either of two shapes, and a name in neither is invisible
# to the lease, the guard and the taskboard alike. `gpu-lease` refuses to run when BOTH are
# empty, because it then cannot tell an idle box from one holding 90 GiB.

# SHAPE ONE – a model with its own systemd unit. Each entry is unit:port:gguf:container,
# space-separated, trailing fields may be empty. Every consumer reads the fields it needs:
# the lease the gguf (so a refusal can say "one of ours, unleased" instead of "a stranger"),
# the guard the container (so a resident is identified by container AND port, not by
# whatever binds the port), the taskboard the unit as its fallback when the lease verb is
# not deployed.
#
# The gguf is a label: a stale name mislabels a message, it does not misbehave. The port is
# not – it is what identifies a resident running inside a toolbox container, where no unit
# name appears in the cgroup at all.
#
# Empty means every standing model is router-held (shape two). The key stays because another
# machine, and the test harness, serve this way. An override in the environment beats this
# file: HATCH_RESIDENTS wholesale, or HATCH_RESIDENT_UNIT/PORT/GGUF for a single-resident
# machine and the test harness.
HATCH_RESIDENTS=""

# SHAPE TWO – a model llama-swap holds. Space-separated llama-swap MODEL IDS, exactly as they
# are spelled in engine/infra/model-serving/llama-swap.yaml and mirrored in the `swap_id` key
# of engine/models.toml. There is no unit and no stable port to name: llama-swap assigns
# ports from `startPort` at load time, so identity here is the id and nothing else.
#
# What each consumer does with it:
#   · gpu-lease  – `status` and `active_residents` ask the router's /running which of these
#                  are loaded; `--resident stop` reclaims them through the router's own
#                  unload API; `--resident serve` pokes each one so it is loaded before the
#                  caller needs it.
#   · hatch-serving-guard – needs nothing: a router-hosted model is already recognised by
#                  llama-swap's cgroup, which is a stronger test than any name list.
#   · taskboard  – a loaded member is standing tier, not work, and gets no NO LEASE flag.
#
# Only models a human has to take down go here. A router member that unloads on its own
# ttl (zimage) or holds no GPU at all (speech, on the CPU) is deliberately absent: listing
# zimage would make `--resident serve` generate an image's worth of load, and listing speech
# would make a GPU registry answer for a process that holds none. Both come back on their
# next request. models-check.py reads `swap_id` for its comparison and this key only for
# what must be standing.
HATCH_ROUTER_RESIDENTS="qnext qwen3.5-4b"

# PAUSED WHILE AN IMAGE GENERATES: llama-swap model ids, space-separated. An image's peak is the
# box's tightest moment (110.1 GiB, 6.9 GiB available under maxload, 2026-09-27), so
# `hatch-image-front` unloads each of these that is idle before a generation and reloads it
# after; `hatch-serving-guard` holds a start of one of them for as long as a generation runs,
# so a caller sees a slower answer and no error. The resident is never here.
HATCH_IMAGE_PAUSES="qwen3.5-4b"

# UNLOADED FIRST WHEN MEMORY IS SHORT, lowest value first: llama-swap model ids, space-separated.
# `hatch-serving-guard` unloads the idle ones before it refuses a load for memory, and
# `hatch-pressure-watch` unloads the first idle one when MemAvailable falls below its floor.
# Each is idle when no image is generating (the front's marker), which is only the right test
# for an image entry: a text model added here needs a busy test of its own first. The resident
# is never here, and the delegate is not either – it stands, and `models-check.py` would report
# every unload of it as drift; its pause belongs to image generation, above.
HATCH_UNLOAD_ORDER="zimage"
